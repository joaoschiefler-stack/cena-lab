{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cena-lab.local/schemas/episode.v1.schema.json",
  "title": "CENA LAB — episódio de comédia seriada (v1)",
  "description": "Rascunho de episódio sem tempos absolutos: tudo se ancora em falas do roteiro e vira frame só depois do alinhamento da narração.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "cena-lab.episode/1"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,40}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "language": {
          "const": "pt-BR"
        },
        "format": {
          "const": "comedia_seriada_v1"
        },
        "seriesId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,40}$"
        },
        "seriesTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "episode": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "premise": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "targetDuration": {
          "type": "number",
          "minimum": 15,
          "maximum": 180
        }
      },
      "required": [
        "id",
        "title",
        "language",
        "format",
        "seriesId",
        "seriesTitle",
        "episode",
        "premise",
        "goal",
        "targetDuration"
      ]
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "visual": {
          "const": "cartoon2d"
        },
        "narratorTone": {
          "enum": [
            "sarcastico",
            "ironico",
            "energetico",
            "humoristico",
            "serio"
          ]
        }
      },
      "required": [
        "visual",
        "narratorTone"
      ]
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "danger": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "optionA": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "optionB": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "captionHighlight": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "required": [
        "accent",
        "danger",
        "optionA",
        "optionB",
        "captionHighlight"
      ]
    },
    "cast": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/castMember"
      },
      "minItems": 1,
      "maxItems": 8
    },
    "sets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/set"
      },
      "minItems": 1,
      "maxItems": 8
    },
    "hud": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hudItem"
          },
          "minItems": 0,
          "maxItems": 4
        }
      },
      "required": [
        "enabled",
        "items"
      ]
    },
    "script": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scriptLine"
          },
          "minItems": 1,
          "maxItems": 80
        }
      },
      "required": [
        "lines"
      ]
    },
    "beats": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/beat"
      },
      "minItems": 1,
      "maxItems": 40
    },
    "vote": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "$ref": "#/$defs/anchor"
        },
        "duration": {
          "type": "number",
          "minimum": 4,
          "maximum": 20
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 70
        },
        "a": {
          "$ref": "#/$defs/voteOption"
        },
        "b": {
          "$ref": "#/$defs/voteOption"
        },
        "cta": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "actor": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,40}$"
        }
      },
      "required": [
        "from",
        "duration",
        "question",
        "a",
        "b",
        "cta",
        "actor"
      ]
    },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "previous": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "episode": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 499
                },
                "choice": {
                  "enum": [
                    "A",
                    "B"
                  ]
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 42
                }
              },
              "required": [
                "episode",
                "choice",
                "label"
              ]
            }
          ]
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "minItems": 0,
          "maxItems": 30
        }
      },
      "required": [
        "facts"
      ]
    }
  },
  "required": [
    "schema",
    "meta",
    "style",
    "theme",
    "cast",
    "sets",
    "hud",
    "script",
    "beats",
    "vote",
    "continuity"
  ],
  "$defs": {
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "line": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,40}$"
        },
        "word": {
          "type": "integer",
          "minimum": 0
        },
        "edge": {
          "enum": [
            "start",
            "end"
          ]
        },
        "offset": {
          "type": "number",
          "minimum": -5,
          "maximum": 10
        }
      },
      "required": [
        "line"
      ]
    },
    "castMember": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,40}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "model": {
          "enum": [
            "teen",
            "adult"
          ]
        },
        "skin": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "hair": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "hairStyle": {
          "enum": [
            "spiky",
            "curly",
            "bun",
            "short",
            "bald",
            "long"
          ]
        },
        "top": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "bottom": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "accessory": {
          "enum": [
            "none",
            "glasses",
            "tie",
            "cap",
            "headphones",
            "lanyard",
            "backpack"
          ]
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "personality": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      },
      "required": [
        "id",
        "name",
        "model",
        "skin",
        "hair",
        "hairStyle",
        "top",
        "bottom",
        "accessory",
        "accent"
      ]
    },
    "set": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,40}$"
        },
        "kind": {
          "enum": [
            "bedroom",
            "classroom",
            "hallway",
            "office",
            "schoolyard"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 28
        },
        "wall": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "floor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "trim": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "required": [
        "id",
        "kind",
        "label"
      ]
    },
    "hudItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,40}$"
        },
        "kind": {
          "enum": [
            "countdown",
            "meter",
            "objective",
            "progress"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 22
        },
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 9999
        },
        "max": {
          "type": "number",
          "minimum": 1,
          "maximum": 9999
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      },
      "required": [
        "id",
        "kind",
        "label",
        "value"
      ]
    },
    "scriptLine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,40}$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "emphasis": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          },
          "minItems": 0,
          "maxItems": 6
        }
      },
      "required": [
        "id",
        "text"
      ]
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "close",
            "medium",
            "wide"
          ]
        },
        "subject": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,40}$"
        },
        "pan": {
          "enum": [
            "left",
            "right",
            "none"
          ]
        }
      },
      "required": [
        "type"
      ]
    },
    "actorState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,40}$"
        },
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "facing": {
          "enum": [
            "left",
            "right"
          ]
        },
        "pose": {
          "enum": [
            "idle",
            "walk",
            "run",
            "phone",
            "point",
            "shrug",
            "panic",
            "facepalm",
            "sneak",
            "cheer",
            "talk",
            "think",
            "slump",
            "shocked",
            "arms_crossed",
            "hide"
          ]
        },
        "expression": {
          "enum": [
            "neutral",
            "happy",
            "smug",
            "panic",
            "shocked",
            "nervous",
            "angry",
            "sad",
            "deadpan",
            "sly",
            "determined"
          ]
        },
        "look": {
          "enum": [
            "left",
            "right",
            "up",
            "down",
            "camera",
            "phone"
          ]
        }
      },
      "required": [
        "id",
        "x",
        "pose",
        "expression"
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "at": {
          "$ref": "#/$defs/anchor"
        },
        "actor": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,40}$"
        },
        "pose": {
          "enum": [
            "idle",
            "walk",
            "run",
            "phone",
            "point",
            "shrug",
            "panic",
            "facepalm",
            "sneak",
            "cheer",
            "talk",
            "think",
            "slump",
            "shocked",
            "arms_crossed",
            "hide"
          ]
        },
        "expression": {
          "enum": [
            "neutral",
            "happy",
            "smug",
            "panic",
            "shocked",
            "nervous",
            "angry",
            "sad",
            "deadpan",
            "sly",
            "determined"
          ]
        },
        "look": {
          "enum": [
            "left",
            "right",
            "up",
            "down",
            "camera",
            "phone"
          ]
        },
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "facing": {
          "enum": [
            "left",
            "right"
          ]
        },
        "shot": {
          "$ref": "#/$defs/shot"
        },
        "shake": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "hud": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "item": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,40}$"
            },
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 9999
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          },
          "required": [
            "item",
            "value"
          ]
        }
      },
      "required": [
        "at"
      ]
    },
    "chatMessage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "audio": {
          "type": "boolean"
        },
        "mine": {
          "type": "boolean"
        }
      },
      "required": [
        "from",
        "text"
      ]
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,40}$"
        },
        "kind": {
          "enum": [
            "phone",
            "notification",
            "tag",
            "alert",
            "sticker",
            "stamp"
          ]
        },
        "slot": {
          "enum": [
            "top",
            "center",
            "left",
            "right",
            "bottom"
          ]
        },
        "from": {
          "$ref": "#/$defs/anchor"
        },
        "until": {
          "$ref": "#/$defs/anchor"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 90
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/chatMessage"
          },
          "minItems": 1,
          "maxItems": 6
        },
        "sticker": {
          "enum": [
            "skull",
            "fire",
            "sweat",
            "exclaim",
            "question",
            "eyes",
            "clock",
            "check",
            "cross",
            "lightbulb",
            "audio"
          ]
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "required": [
        "id",
        "kind",
        "slot",
        "from"
      ]
    },
    "beat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,40}$"
        },
        "from": {
          "$ref": "#/$defs/anchor"
        },
        "set": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,40}$"
        },
        "shot": {
          "$ref": "#/$defs/shot"
        },
        "transition": {
          "enum": [
            "cut",
            "whip",
            "flash",
            "smash"
          ]
        },
        "actors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/actorState"
          },
          "minItems": 0,
          "maxItems": 4
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          },
          "minItems": 0,
          "maxItems": 30
        },
        "overlays": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/overlay"
          },
          "minItems": 0,
          "maxItems": 6
        },
        "captions": {
          "enum": [
            "upper",
            "center",
            "lower"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "id",
        "from",
        "set",
        "shot",
        "actors",
        "purpose"
      ]
    },
    "voteOption": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 42
        },
        "consequence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "pose": {
          "enum": [
            "idle",
            "walk",
            "run",
            "phone",
            "point",
            "shrug",
            "panic",
            "facepalm",
            "sneak",
            "cheer",
            "talk",
            "think",
            "slump",
            "shocked",
            "arms_crossed",
            "hide"
          ]
        },
        "expression": {
          "enum": [
            "neutral",
            "happy",
            "smug",
            "panic",
            "shocked",
            "nervous",
            "angry",
            "sad",
            "deadpan",
            "sly",
            "determined"
          ]
        }
      },
      "required": [
        "label",
        "consequence",
        "pose",
        "expression"
      ]
    }
  }
}
